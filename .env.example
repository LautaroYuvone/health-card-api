# Configuración general de la API
PROJECT_NAME="Tarjeta Sanitaria API"
API_V1_STR="/api/v1"

# Seguridad y JWT
# Generar una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="tu_clave_secreta_super_segura_aqui"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_TOKEN_EXPIRE_MINUTES=15

# Conexión a PostgreSQL (formato: postgresql://usuario:password@host:puerto/nombre_db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarjeta_sanitaria"